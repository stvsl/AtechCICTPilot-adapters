{
    "ManifestVersion": 2,
    "PackageId": "canoe_flash_adapter",
    "PackageNameCN": "CANoe Flash 适配器",
    "PackageNameEN": "CANoe Flash Adapter",
    "PackageVersion": "1.0.0",
    "DescriptionCN": "使用CANoe完成刷写任务",
    "DescriptionEN": "Use CANoe to complete the flash task",
    "Author": "DOTRUST",
    "NodeType": "Flash",
    "NodeAdapterNameCN": "CANoe 刷写",
    "NodeAdapterNameEN": "CANoe Flash",
    "Runtime": {
        "ApiVersion": "1.0",
        "Language": "javascript",
        "Workflow": "workflow.json"
    },
    "Permissions": {
        "COM": {
            "ProgIds": [
                "CANoe.Application"
            ],
            "AllowActiveObject": true
        },
        "CLI": {
            "Executables": [
                {
                    "DeviceProperty": "CANOE_SOFTWARE_POSITION"
                }
            ],
            "AllowTerminal": false
        }
    },
    "CallingRuntime": [
        "COM",
        "CLI"
    ],
    "SelfExaminationAbility": true,
    "RequirementProperty": [
        {
            "id": "CANOE_PROJECT",
            "nameCN": "CANoe 工程文件",
            "nameEN": "CANoe Project File",
            "type": "file",
            "fileExtension": ".zip",
            "required": true
        },
        {
            "id": "SOFTWARE_PACKAGE",
            "nameCN": "软件包",
            "nameEN": "Software Package",
            "type": "file",
            "fileExtension": ".bin|.s7|.s19|.hex|.elf",
            "required": true
        },
        {
            "id": "FLASH_PARAMETERS",
            "nameCN": "刷写参数（JSON）",
            "nameEN": "Flash Parameters (JSON)",
            "type": "file",
            "fileExtension": ".json",
            "required": false
        }
    ],
    "OnDeviceProperty": [
        {
            "id": "CANOE_SOFTWARE_POSITION",
            "nameCN": "CANoe 可执行文件",
            "nameEN": "CANoe Executable",
            "type": "string_url_file",
            "required": true
        },
        {
            "id": "CANOE_PROJECT_DIR",
            "nameCN": "任务工作区根目录",
            "nameEN": "Task Workspace Root",
            "type": "string_url_dir",
            "required": false
        },
        {
            "id": "NEW_CANOE_WHEN_START",
            "nameCN": "启动时新建 CANoe",
            "nameEN": "Start New CANoe",
            "type": "boolean",
            "required": false
        }
    ]
}
