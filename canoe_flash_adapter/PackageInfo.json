{
    "ManifestVersion": 2,
    "PackageId": "canoe_flash_adapter",
    "PackageNameCN": "CANoe Flash 适配器",
    "PackageNameEN": "CANoe Flash Adapter",
    "PackageVersion": "1.0.0",
    "DescriptionCN": "使用CANoe完成刷写任务",
    "DescriptionEN": "Use CANoe to complete the flash task",
    "Author": "DOTRUST",
    "NodeType": "Flash",
    "CapabilityNameCN": "CANoe 刷写",
    "CapabilityNameEN": "CANoe Flash",
    "PlatformEngineeringInfo": [
        {
            "EngineeringPackageId": "CANOE_FLASH_PACKAGE",
            "EngineeringPackageNameCN": "CANoE刷写工程",
            "EngineeringPackageNameEN": "CANoE Flash Package"
        }
    ],
    "Runtime": {
        "ApiVersion": "1.0",
        "Language": "javascript"
    },
    "Permissions": {
        "COM": {
            "ProgIds": [
                "CANoe.Application"
            ],
            "AllowActiveObject": true
        },
        "CLI": {
            "Executables": [
                {
                    "Id": "CANOE_EXECUTABLE",
                    "WindowsInstalledProduct": {
                        "DisplayNameTemplate": "Vector CANoe {version}",
                        "VersionDeviceProperty": "CANOE_VERSION",
                        "RelativePath": "Exec64/CANoe64.exe",
                        "PathDeviceProperty": "CANOE_INSTALL_DIR"
                    }
                },
                {
                    "Id": "CANOE_COM_REGISTRAR",
                    "AllowElevation": true,
                    "WindowsInstalledProduct": {
                        "DisplayNameTemplate": "Vector CANoe {version}",
                        "VersionDeviceProperty": "CANOE_VERSION",
                        "RelativePath": "Exec64/RegisterComponents.exe",
                        "PathDeviceProperty": "CANOE_INSTALL_DIR"
                    }
                }
            ],
            "AllowTerminal": false
        }
    },
    "CallingRuntime": [
        "COM",
        "CLI"
    ],
    "SelfExaminationAbility": true,
    "RequirementProperty": [
        {
            "id": "CANOE_PROJECT",
            "nameCN": "CANoe 工程文件",
            "nameEN": "CANoe Project File",
            "type": "file",
            "fileExtension": ".zip",
            "required": true,
            "platform": {
                "type": "EngineeringPackage",
                "tags": [
                    "CANOE_FLASH_PACKAGE"
                ]
            }
        },
        {
            "id": "SOFTWARE_PACKAGE",
            "nameCN": "软件包",
            "nameEN": "Software Package",
            "type": "file",
            "fileExtension": ".bin|.s7|.s19|.hex|.elf",
            "required": true,
            "platform": {
                "type": "SoftwarePackage",
                "tags": []
            }
        },
        {
            "id": "FLASH_PARAMETERS",
            "nameCN": "刷写参数（JSON）",
            "nameEN": "Flash Parameters (JSON)",
            "type": "file",
            "fileExtension": ".json",
            "required": false,
            "platform": {
                "type": "ParameterConfig",
                "tags": [
                    "_CANOE_PROJECT(./parameter.json)"
                ]
            }
        }
    ],
    "OnDeviceProperty": [
        {
            "id": "CANOE_VERSION",
            "nameCN": "CANoe 版本",
            "nameEN": "CANoe Version",
            "type": "enum",
            "values": [
                {
                    "id": "15",
                    "nameCN": "CANoe 15",
                    "nameEN": "CANoe 15"
                },
                {
                    "id": "16",
                    "nameCN": "CANoe 16",
                    "nameEN": "CANoe 16"
                },
                {
                    "id": "17",
                    "nameCN": "CANoe 17",
                    "nameEN": "CANoe 17"
                },
                {
                    "id": "18",
                    "nameCN": "CANoe 18",
                    "nameEN": "CANoe 18"
                },
                {
                    "id": "19",
                    "nameCN": "CANoe 19",
                    "nameEN": "CANoe 19"
                },
                {
                    "id": "20",
                    "nameCN": "CANoe 20",
                    "nameEN": "CANoe 20"
                }
            ],
            "required": true
        },
        {
            "id": "CANOE_PROJECT_DIR",
            "nameCN": "任务工作区根目录",
            "nameEN": "Task Workspace Root",
            "type": "directory",
            "required": false
        },
        {
            "id": "CANOE_INSTALL_DIR",
            "nameCN": "CANoe 安装目录（自动发现失败时指定）",
            "nameEN": "CANoe Installation Directory (used when discovery fails)",
            "type": "directory",
            "required": false
        },
        {
            "id": "NEW_CANOE_WHEN_START",
            "nameCN": "启动时新建 CANoe",
            "nameEN": "Start New CANoe",
            "type": "boolean",
            "required": false
        }
    ]
}
