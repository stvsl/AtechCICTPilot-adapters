{
    "ManifestVersion": 2,
    "PackageId": "vcarea_test_adapter",
    "PackageNameCN": "VCarEA 测试适配器",
    "PackageNameEN": "VCarEA Test Adapter",
    "PackageVersion": "1.0.0",
    "DescriptionCN": "启动昆易 VCarEA、查询 MQTT 连接配置并执行工程内测试用例",
    "DescriptionEN": "Start VCarEA, query its MQTT connection configuration, and execute project test cases",
    "Author": "DOTRUST",
    "NodeType": "Test",
    "CapabilityNameCN": "VCarEA 测试",
    "CapabilityNameEN": "VCarEA Test",
    "PlatformEngineeringInfo": [
        {
            "EngineeringPackageId": "VCAR_EA_TEST_PACKAGE",
            "EngineeringPackageNameCN": "VCarEA 测试工程",
            "EngineeringPackageNameEN": "VCarEA Test Package"
        }
    ],
    "Runtime": {
        "ApiVersion": "1.0",
        "Language": "javascript"
    },
    "Permissions": {
        "CLI": {
            "Executables": [
                {
                    "Path": "C:\\KunyiSoftwares\\VCarEA\\VCarEA.exe"
                },
                {
                    "DeviceProperty": "VCAR_EA_SOFTWARE_PATH"
                }
            ],
            "AllowTerminal": false
        },
        "MQTT": {
            "ProtocolVersion": "3.1.1"
        }
    },
    "CallingRuntime": [
        "CLI",
        "MQTT"
    ],
    "SelfExaminationAbility": true,
    "RequirementProperty": [
        {
            "id": "VCAR_EA_PROJECT",
            "nameCN": "VCarEA 工程",
            "nameEN": "VCarEA Project",
            "type": "file",
            "fileExtension": ".zip",
            "required": true,
            "platform": {
                "type": "EngineeringPackage",
                "tags": [
                    "VCAR_EA_TEST_PACKAGE"
                ]
            }
        },
        {
            "id": "TEST_CASE_IDS",
            "nameCN": "测试用例 ID（文本或 JSON 文件，可选）",
            "nameEN": "Test Case IDs (text or JSON file, optional)",
            "type": "text_file",
            "fileExtension": ".json|.txt",
            "required": false,
            "platform": {
                "type": "CaseSelection",
                "tags": []
            }
        },
        {
            "id": "VCAR_EA_REPORT_TYPE",
            "nameCN": "VCarEA 测试报告类型",
            "nameEN": "VCarEA Test Report Type",
            "type": "enum_multi",
            "values": [
                {
                    "id": "html",
                    "nameCN": "HTML 报告",
                    "nameEN": "HTML Report"
                },
                {
                    "id": "pdf",
                    "nameCN": "PDF 报告",
                    "nameEN": "PDF Report"
                },
                {
                    "id": "xlsx",
                    "nameCN": "XLSX 报告",
                    "nameEN": "XLSX Report"
                },
                {
                    "id": "zip",
                    "nameCN": "VCarEA 原生 ZIP 报告",
                    "nameEN": "VCarEA Native ZIP Report"
                }
            ],
            "required": true,
            "platform": {
                "type": "Original",
                "tags": []
            }
        }
    ],
    "OnDeviceProperty": [
        {
            "id": "VCAR_EA_SOFTWARE_PATH",
            "nameCN": "VCarEA 软件路径",
            "nameEN": "VCarEA Software Path",
            "type": "string_url_file",
            "fileExtension": ".exe",
            "required": false
        },
        {
            "id": "VCAR_EA_WORK_DIR",
            "nameCN": "VCarEA 工作目录",
            "nameEN": "VCarEA Work Directory",
            "type": "string_url_dir",
            "required": false
        },
        {
            "id": "VCAR_EA_DEVICE_CONFIG_PATH",
            "nameCN": "VCarEA 设备配置路径",
            "nameEN": "VCarEA Device Configuration Path",
            "type": "string_url_file",
            "fileExtension": ".zip",
            "required": false
        }
    ]
}
