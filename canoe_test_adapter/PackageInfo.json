{
    "ManifestVersion": 2,
    "PackageId": "canoe_test_adapter",
    "PackageNameCN": "CANoe 测试适配器",
    "PackageNameEN": "CANoe Test Adapter",
    "PackageVersion": "1.0.0",
    "DescriptionCN": "通过 CANoe Test Configuration 执行 VTESTStudio 测试单元",
    "DescriptionEN": "Execute VTESTStudio test units through a CANoe Test Configuration",
    "Author": "DOTRUST",
    "NodeType": "Test",
    "NodeAdapterNameCN": "CANoe 测试",
    "NodeAdapterNameEN": "CANoe Test",
    "Runtime": {
        "ApiVersion": "1.0",
        "Language": "javascript",
        "Workflow": "workflow.json"
    },
    "Permissions": {
        "COM": {
            "ProgIds": [
                "CANoe.Application"
            ],
            "AllowActiveObject": true
        },
        "CLI": {
            "Executables": [
                {
                    "DeviceProperty": "CANOE_SOFTWARE_POSITION"
                },
                {
                    "DeviceProperty": "CANOE_REPORT_VIEWER_CLI"
                }
            ],
            "AllowTerminal": false
        }
    },
    "CallingRuntime": [
        "COM",
        "CLI"
    ],
    "SelfExaminationAbility": true,
    "RequirementProperty": [
        {
            "id": "CANOE_PROJECT",
            "nameCN": "CANoe 工程文件",
            "nameEN": "CANoe Project File",
            "type": "file",
            "fileExtension": ".zip",
            "required": true
        },
        {
            "id": "TEST_CASE_IDS",
            "nameCN": "测试用例 ID（文本或 JSON 文件，可选）",
            "nameEN": "Test Case IDs (text or JSON file, optional)",
            "type": "text_file",
            "fileExtension": ".json|.txt",
            "required": false
        },
        {
            "id": "CANOE_REPORT_TYPE",
            "nameCN": "CANoe 测试报告类型",
            "nameEN": "CANoe Test Report Type",
            "type": "enum_multi",
            "values": [
                {
                    "id": "vtestreport",
                    "nameCN": "CANoe 原生 VTESTReport",
                    "nameEN": "CANoe native VTESTReport (.vtestreport)"
                },
                {
                    "id": "XML",
                    "nameCN": "CANoe XML 报告",
                    "nameEN": "CANoe XML Report"
                },
                {
                    "id": "XUnit",
                    "nameCN": "CANoe Report Viewer XUnit 导出",
                    "nameEN": "CANoe Report Viewer XUnit Export"
                },
                {
                    "id": "PDF",
                    "nameCN": "CANoe Report Viewer PDF 导出",
                    "nameEN": "CANoe Report Viewer PDF Export"
                }
            ],
            "required": true
        }
    ],
    "OnDeviceProperty": [
        {
            "id": "CANOE_SOFTWARE_POSITION",
            "nameCN": "CANoe 可执行文件",
            "nameEN": "CANoe Executable",
            "type": "string_url_file",
            "required": true
        },
        {
            "id": "CANOE_PROJECT_DIR",
            "nameCN": "任务工作区根目录",
            "nameEN": "Task Workspace Root",
            "type": "string_url_dir",
            "required": false
        },
        {
            "id": "CANOE_REPORT_VIEWER_CLI",
            "nameCN": "CANoe 报告查看器命令行工具",
            "nameEN": "CANoe Report Viewer CLI",
            "type": "string_url_file",
            "fileExtension": ".exe",
            "required": false
        },
        {
            "id": "NEW_CANOE_WHEN_START",
            "nameCN": "启动时新建 CANoe 实例",
            "nameEN": "Create New CANoe Instance on Start",
            "type": "boolean",
            "required": true
        }
    ]
}
