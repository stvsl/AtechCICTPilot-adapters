{
    "ManifestVersion": 2,
    "PackageId": "canoe_test_adapter",
    "PackageNameCN": "CANoe 测试适配器",
    "PackageNameEN": "CANoe Test Adapter",
    "PackageVersion": "1.0.0",
    "DescriptionCN": "通过 CANoe Test Configuration 执行 VTESTStudio 测试单元",
    "DescriptionEN": "Execute VTESTStudio test units through a CANoe Test Configuration",
    "Author": "DOTRUST",
    "NodeType": "Test",
    "CapabilityNameCN": "CANoe 测试",
    "CapabilityNameEN": "CANoe Test",
    "PlatformEngineeringInfo": [
        {
            "EngineeringPackageId": "CANOE_TEST_PACKAGE_TEST_MODEL",
            "EngineeringPackageNameCN": "CANoE Test Model 工程",
            "EngineeringPackageNameEN": "CANoE Test Model Package"
        },
        {
            "EngineeringPackageId": "CANOE_TEST_PACKAGE_TEST_UNIT",
            "EngineeringPackageNameCN": "CANoE Test Unit 工程",
            "EngineeringPackageNameEN": "CANoE Test Unit Package"
        }
    ],
    "Runtime": {
        "ApiVersion": "1.0",
        "Language": "javascript"
    },
    "Permissions": {
        "COM": {
            "ProgIds": [
                "CANoe.Application"
            ],
            "AllowActiveObject": true
        },
        "CLI": {
            "Executables": [
                {
                    "Id": "CANOE_EXECUTABLE",
                    "WindowsInstalledProduct": {
                        "DisplayNameTemplate": "Vector CANoe {version}",
                        "VersionDeviceProperty": "CANOE_VERSION",
                        "RelativePath": "Exec64/CANoe64.exe"
                    }
                },
                {
                    "Id": "CANOE_SABCMD",
                    "WindowsInstalledProduct": {
                        "DisplayNameTemplate": "Vector CANoe {version}",
                        "VersionDeviceProperty": "CANOE_VERSION",
                        "RelativePath": "Exec64/sabcmd.exe"
                    }
                },
                {
                    "Id": "CANOE_REPORT_VIEWER",
                    "WindowsInstalledProduct": {
                        "DisplayNameTemplate": "Vector CANoe Test Report Viewer {version}",
                        "VersionDeviceProperty": "CANOE_VERSION",
                        "RelativePath": "ReportViewerCli.exe",
                        "AllowDisplayNameSuffix": true
                    }
                }
            ],
            "AllowTerminal": false
        }
    },
    "CallingRuntime": [
        "COM",
        "CLI"
    ],
    "SelfExaminationAbility": true,
    "RequirementProperty": [
        {
            "id": "CANOE_PROJECT",
            "nameCN": "CANoe 工程文件",
            "nameEN": "CANoe Project File",
            "type": "file",
            "fileExtension": ".zip",
            "required": true,
            "platform": {
                "type": "EngineeringPackage",
                "tags": [
                    "CANOE_TEST_PACKAGE_TEST_MODEL",
                    "CANOE_TEST_PACKAGE_TEST_UNIT"
                ]
            }
        },
        {
            "id": "TEST_CASE_IDS",
            "nameCN": "测试用例",
            "nameEN": "Test Case",
            "type": "text_file",
            "fileExtension": ".json|.txt",
            "required": false,
            "platform": {
                "type": "CaseSelection",
                "tags": []
            }
        },
        {
            "id": "CANOE_REPORT_TYPE",
            "nameCN": "CANoe 测试报告类型",
            "nameEN": "CANoe Test Report Type",
            "type": "enum_multi",
            "values": [
                {
                    "id": "vtestreport",
                    "nameCN": "CANoe 原生 VTESTReport",
                    "nameEN": "CANoe native VTESTReport (.vtestreport)"
                },
                {
                    "id": "XML",
                    "nameCN": "CANoe XML 报告",
                    "nameEN": "CANoe XML Report"
                },
                {
                    "id": "HTML",
                    "nameCN": "CANoe HTML 报告",
                    "nameEN": "CANoe HTML Report"
                },
                {
                    "id": "PDF",
                    "nameCN": "CANoe Report Viewer PDF 报告",
                    "nameEN": "CANoe Report Viewer PDF Report"
                }
            ],
            "required": true,
            "platform": {
                "type": "Original",
                "tags": []
            }
        }
    ],
    "OnDeviceProperty": [
        {
            "id": "CANOE_VERSION",
            "nameCN": "CANoe 版本",
            "nameEN": "CANoe Version",
            "type": "enum",
            "values": [
                {
                    "id": "16",
                    "nameCN": "CANoe 16",
                    "nameEN": "CANoe 16"
                },
                {
                    "id": "17",
                    "nameCN": "CANoe 17",
                    "nameEN": "CANoe 17"
                },
                {
                    "id": "18",
                    "nameCN": "CANoe 18",
                    "nameEN": "CANoe 18"
                },
                {
                    "id": "19",
                    "nameCN": "CANoe 19",
                    "nameEN": "CANoe 19"
                },
                {
                    "id": "20",
                    "nameCN": "CANoe 20",
                    "nameEN": "CANoe 20"
                }
            ],
            "required": true
        },
        {
            "id": "CANOE_PROJECT_DIR",
            "nameCN": "任务工作区根目录",
            "nameEN": "Task Workspace Root",
            "type": "directory",
            "required": false
        },
        {
            "id": "NEW_CANOE_WHEN_START",
            "nameCN": "启动时新建 CANoe 实例",
            "nameEN": "Create New CANoe Instance on Start",
            "type": "boolean",
            "required": true
        }
    ]
}
