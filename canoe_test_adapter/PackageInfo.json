{
    "ManifestVersion": 2,
    "PackageId": "canoe_test_adapter",
    "PackageNameCN": "CANoe 测试适配器",
    "PackageNameEN": "CANoe Test Adapter",
    "PackageVersion": "1.0.0",
    "DescriptionCN": "通过 CANoe Test Configuration 执行 VTESTStudio 测试单元",
    "DescriptionEN": "Execute VTESTStudio test units through a CANoe Test Configuration",
    "Author": "DOTRUST",
    "NodeType": "Test",
    "NodeAdapterNameCN": "CANoe 测试",
    "NodeAdapterNameEN": "CANoe Test",
    "Runtime": {
        "ApiVersion": "1.0",
        "Language": "javascript",
        "Workflow": "workflow.json"
    },
    "Permissions": {
        "COM": {
            "ProgIds": [
                "CANoe.Application"
            ],
            "AllowActiveObject": true
        },
        "CLI": {
            "Executables": [
                {
                    "DeviceProperty": "CANOE_SOFTWARE_POSITION"
                }
            ],
            "AllowTerminal": false
        }
    },
    "CallingRuntime": [
        "COM",
        "CLI"
    ],
    "SelfExaminationAbility": true,
    "RequirementProperty": [
        {
            "id": "CANOE_PROJECT",
            "nameCN": "CANoe 工程文件",
            "nameEN": "CANoe Project File",
            "type": "file",
            "fileExtension": ".zip",
            "required": true
        },
        {
            "id": "TEST_SCRIPTS",
            "nameCN": "VTESTStudio 测试脚本（可选）",
            "nameEN": "VTESTStudio Test Scripts (optional)",
            "type": "file",
            "fileExtension": ".zip|.vtuexe|.tse|.xml",
            "required": false
        },
        {
            "id": "TEST_CASE_IDS",
            "nameCN": "测试用例 ID（JSON 或文本，可选）",
            "nameEN": "Test Case IDs (JSON or text, optional)",
            "type": "file",
            "fileExtension": ".json|.txt",
            "required": false
        }
    ],
    "OnDeviceProperty": [
        {
            "id": "CANOE_SOFTWARE_POSITION",
            "nameCN": "CANoe 可执行文件",
            "nameEN": "CANoe Executable",
            "type": "string_url_file",
            "required": true
        },
        {
            "id": "CANOE_PROJECT_DIR",
            "nameCN": "任务工作区根目录",
            "nameEN": "Task Workspace Root",
            "type": "string_url_dir",
            "required": false
        }
    ]
}
