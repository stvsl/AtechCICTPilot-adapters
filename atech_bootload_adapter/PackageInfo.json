{
    "ManifestVersion": 2,
    "PackageId": "atech_bootload_adapter",
    "PackageNameCN": "埃泰克BootLoader刷写工具适配器",
    "PackageNameEN": "ATECH Bootloader Flash Tool Adapter",
    "PackageVersion": "1.0.1",
    "DescriptionCN": "埃泰克BootLoader刷写工具",
    "DescriptionEN": "ATECH BootLoader Flash Tool",
    "Author": "DOTRUST",
    "NodeType": "Flash",
    "CapabilityNameCN": "埃泰克BootLoader刷写",
    "CapabilityNameEN": "ATECH Bootloader Flash",
    "PlatformEngineeringInfo": [
        {
            "EngineeringPackageId": "ATECH_FLASH_PARAMETERS_PACKAGE",
            "EngineeringPackageNameCN": "埃泰克UDS刷写参数包",
            "EngineeringPackageNameEN": "ATECH UDS Flash Parameters"
        }
    ],
    "Runtime": {
        "ApiVersion": "1.0",
        "Language": "javascript"
    },
    "Permissions": {
        "CLI": {
            "Executables": [
                {
                    "Id": "bootload",
                    "DeviceProperty": "CLI_PATH"
                }
            ],
            "AllowTerminal": false
        }
    },
    "CallingRuntime": [
        "CLI"
    ],
    "SelfExaminationAbility": true,
    "RequirementProperty": [
        {
            "id": "CONFIG_PACKAGE",
            "nameCN": "配置参数包",
            "nameEN": "ConfigParametersPackage",
            "type": "file",
            "required": true,
            "fileExtension": ".zip",
            "platform": {
                "type": "EngineeringPackage",
                "tags": [
                    "ATECH_FLASH_PARAMETERS_PACKAGE"
                ]
            }
        },
        {
            "id": "APP_FILE",
            "nameCN": "Application 固件",
            "nameEN": "Application firmware",
            "type": "file_multi",
            "required": true,
            "fileExtension": ".hex|.vbf|.s19|.mot|.sre|.mbf|.srec"
        },
        {
            "id": "FLASH_DRIVER",
            "nameCN": "Flash Driver 固件（可选）",
            "nameEN": "Flash Driver firmware (optional)",
            "type": "file",
            "required": false,
            "fileExtension": ".hex|.vbf|.s19|.mot|.sre|.mbf|.srec"
        },
        {
            "id": "CALIBRATION",
            "nameCN": "Calibration 固件（可选）",
            "nameEN": "Calibration firmware (optional)",
            "type": "file_multi",
            "required": false,
            "fileExtension": ".hex|.vbf|.s19|.mot|.sre|.mbf|.srec"
        }
    ],
    "OnDeviceProperty": [
        {
            "id": "CLI_PATH",
            "nameCN": "ATECH BootLoad CLI.exe",
            "nameEN": "ATECH BootLoad CLI.exe",
            "type": "file",
            "required": true,
            "fileExtension": ".exe"
        }
    ]
}